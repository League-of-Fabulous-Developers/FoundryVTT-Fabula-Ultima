<label class="fu-form__property">
  <span>{{localize 'FU.Species'}}</span>
  <multi-select name="{{pfuConcat path ".species"}}" class="fu-form__set stacked">
  {{selectOptions options.speciesOptions selected=predicate.species}}
  </multi-select>
</label>
<label class="fu-form__property">
  <span>{{localize 'FU.Quantifier'}}</span>
  <select name="{{pfuConcat path ".quantifier"}}">
    {{selectOptions options.predicateQuantifier selected=predicate.quantifier localize=true}}
  </select>
</label>
