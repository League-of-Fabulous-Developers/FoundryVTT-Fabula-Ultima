<div class="fu-form__property">
  <span>{{localize 'FU.Rank'}}</span>
  <multi-select name="{{pfuConcat path ".ranks"}}" class="fu-form__set stacked">
  {{selectOptions options.rankOptions selected=predicate.ranks }}
  </multi-select>
</div>
<label class="fu-form__property">
  <span>{{localize 'FU.Quantifier'}}</span>
  <select name="{{pfuConcat path ".quantifier"}}">
    {{selectOptions options.predicateQuantifier selected=predicate.quantifier localize=true}}
  </select>
</label>
