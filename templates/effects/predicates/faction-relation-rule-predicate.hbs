<div class="fu-form__property-row">
  <label class="fu-form__property"
         data-tooltip="{{localize 'FU.TargetRelationHint'}}">
    <span>{{localize 'FU.FactionRelation'}}</span>
    <select name="{{pfuConcat path ".relation"}}">
      {{selectOptions options.factionRelation selected=predicate.relation localize=true}}
    </select>
  </label>
  <label class="fu-form__property">
    <span>{{localize 'FU.Inclusive'}}</span>
    <input type="checkbox"
           name="{{pfuConcat path ".inclusive"}}"
           {{checked predicate.inclusive}}>
  </label>
</div>
