<div class="fu-form__property">
  <span>{{localize 'FU.CheckType'}}</span>
  <multi-select name="{{pfuConcat path ".checkTypes"}}" class="fu-form__set stacked">
  {{selectOptions options.checkTypeOptions selected=trigger.checkTypes}}
  </multi-select>
</div>
<div class="fu-form__property-row">
  <label class="fu-form__property">
    <span>{{localize 'FU.Local'}}</span>
    <input type="checkbox"
           name="{{pfuConcat path ".local"}}"
           {{checked trigger.local}}>
  </label>
  <label class="fu-form__property">
    <span>{{localize 'FU.Identifier'}}</span>
    <input type="text"
           name="{{pfuConcat path ".identifier"}}"
           value="{{ trigger.identifier }}" />
  </label>
</div>
