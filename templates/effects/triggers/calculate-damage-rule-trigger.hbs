<div class="fu-form__property">
  <span>{{localize 'FU.ItemGroup'}}</span>
  <multi-select name="{{pfuConcat path ".itemGroups"}}" class="fu-form__set stacked">
  {{selectOptions options.itemGroupOptions selected=trigger.itemGroups}}
  </multi-select>
</div>
<label class="fu-form__property">
  <span>{{localize 'FU.DamageType'}}</span>
  <multi-select name="{{pfuConcat path ".damageTypes"}}" class="fu-form__set stacked">
  {{selectOptions options.damageTypeOptions selected=trigger.damageTypes}}
  </multi-select>
</label>
<div class="fu-form__property-row">
  <label class="fu-form__property">
    <span>{{localize 'FU.Local'}}</span>
    <input type="checkbox"
           name="{{pfuConcat path ".local"}}"
           {{checked trigger.local}}>
  </label>
  <label class="fu-form__property">
    <span>{{localize 'FU.Identifier'}}</span>
    <input type="text"
           name="{{pfuConcat path ".identifier"}}"
           value="{{ trigger.identifier }}" />
  </label>
</div>
