<fieldset class="title-fieldset desc resource-content"
          style="display: flex;
                 flex-wrap: wrap;
                 justify-content: space-around">
  <legend class="resource-label-full">
    <label class="resource-label-m">
      <i class="ra ra-ammo-bag icon"></i>
      {{localize 'FU.Traits'}}
    </label>
  </legend>
  <div class="fu-traits">
    <multi-select class="resource-label-m stacked" name="system.traits">
    {{selectOptions system.traitOptions selected=system.traits}}
    </multi-select>
  </div>
</fieldset>
