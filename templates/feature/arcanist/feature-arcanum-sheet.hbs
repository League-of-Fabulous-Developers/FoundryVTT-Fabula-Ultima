<div class="flexcol flexgrow-1 gap-5">
	<fieldset class="title-fieldset section-container desc resource-content">
		<legend class="resource-label-m">{{localize 'FU.ClassFeatureArcanumDomains'}}</legend>
		<input type='text' name='system.data.domains' value='{{system.data.domains}}'
			   class="resource-inputs select-dropdown-full resource-text-m" />
	</fieldset>
	<fieldset class="title-fieldset section-container desc resource-content">
		<legend class="resource-label-m">{{localize "DOCUMENT.Settings"}}</legend>
		<div class="grid grid-2col gap-5">
			<label for="{{@root.partId}}-enablePulse">{{localize "FU.ClassFeatureArcanumEnablePulse"}}</label>
			<input type="checkbox" name="system.data.enablePulse" id="{{@root.partId}}-enablePulse" {{checked system.data.enablePulse}}>
		</div>
	</fieldset>

	<div class="desc flexcol flexgrow-1">
		<nav class="arcanum-tabs tabs flexrow gap-5" data-group="arcanumTabs">
			<a class="item tab button-style" data-tab="mergeTab">{{localize 'FU.ClassFeatureArcanumMerge'}}</a>
			{{#if system.data.enablePulse}}
				<a class="item tab button-style" data-tab="pulseTab">{{localize 'FU.ClassFeatureArcanumPulse'}}</a>
			{{/if}}
			<a class="item tab button-style" data-tab="dismissTab">{{localize 'FU.ClassFeatureArcanumDismiss'}}</a>
		</nav>

		<hr>

		<div class="arcanum-content flexcol flexgrow-1">
			<div class="tab flexgrow-1" data-group="arcanumTabs" data-tab="mergeTab">
				<prose-mirror name="system.data.merge" value="{{system.data.merge}}" toggled>
					{{{enrichedHtml.merge}}}
				</prose-mirror>
			</div>

			{{#if system.data.enablePulse}}
				<div class="tab flexgrow-1" data-group="arcanumTabs" data-tab="pulseTab">
					<prose-mirror name="system.data.pulse" value="{{system.data.pulse}}" toggled>
						{{{enrichedHtml.pulse}}}
					</prose-mirror>
				</div>
			{{/if}}

			<div class="tab flexgrow-1" data-group="arcanumTabs" data-tab="dismissTab">
				<prose-mirror name="system.data.dismiss" value="{{system.data.dismiss}}" toggled>
					{{{enrichedHtml.dismiss}}}
				</prose-mirror>
			</div>
		</div>
	</div>
</div>