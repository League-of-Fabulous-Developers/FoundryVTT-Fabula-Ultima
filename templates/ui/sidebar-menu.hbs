<section class="info flexcol pfuTools-sidebar__section">
  <h1 class="pfuTools-sidebar__title">{{systemTitle}}</h1>
  <div class="pfuTools-sidebar__subheader">{{systemVersion}}</div>
  <div class="flexrow center">
    <div class="pfuTools-sidebar__link">
      <i class="fa-brands fa-discord"></i>
      <a href="{{links.discord}}">{{localize "FU.SidebarDiscordLink"}}</a>
    </div>
    <div class="pfuTools-sidebar__link">
      <i class="fa-brands fa-github"></i>
      <a href="{{links.wiki}}">{{localize "FU.SidebarWikiLink"}}</a>
    </div>
    <div class="pfuTools-sidebar__link">
      <i class="fa-brands fa-github"></i>
      <a href="{{links.issues}}">{{localize "FU.SidebarIssuesLink"}}</a>
    </div>
    <div class="pfuTools-sidebar__link">
      <i class="fa-brands fa-github"></i>
      <a href="{{links.release}}">{{localize "FU.SidebarReleaseLink"}}</a>
    </div>
  </div>
</section>

{{#each tools as |group|}}
{{#if group.visible}}
<section class="pfuTools-sidebar__{{group.id}} pfuTools-sidebar__section flexcol form-group {{group.expandedClasses}}">
  <h4 class="divider pfuTools-sidebar__header">{{localize group.label}}</h4>
  {{#each group.tools as |tool|}}
  {{#if tool.visible}}
  <button type="button" data-action="clickToolButton" data-group="{{group.id}}" data-tool="{{@key}}"
    class="{{tool.expandedClasses}}" {{#if tool.tooltip}} data-tooltip-html="{{tool.tooltip}}" {{/if}}>
    {{#if tool.icon}}<i class="{{tool.icon}}"></i>{{/if}}
    {{localize tool.label}}
  </button>
  {{/if}}
  {{/each}}
</section>
{{/if}}
{{/each}}